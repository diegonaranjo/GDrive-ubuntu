[Desktop Entry]
Version=1.0
Type=Application
Name=Google Drive
Comment=Desktop client for Google Drive
Comment[es]=Cliente de escritorio para Google Drive
# The launcher has no fixed path until the app is installed, so build-deb.sh
# replaces this placeholder with the installed entry point (/usr/bin/gdrive).
Exec=@GDRIVE_LAUNCHER@
Icon=google-drive
Terminal=false
Categories=Utility;FileTools;Network;
StartupNotify=true
Keywords=Google;Drive;Cloud;Sync;
